# Streamlit Secrets Configuration
# Copy this to Streamlit Cloud: Dashboard → Manage secrets → Paste into secrets.toml

# ========================================
# PAYMENT & SUBSCRIPTION
# ========================================
# Your Whop or other provider checkout URL
WHOP_CHECKOUT_URL = "https://your-whop-checkout-url"

# Your Stripe checkout URL (from Stripe Dashboard)
SUBSCRIPTION_PAYMENT_LINK = "https://buy.stripe.com/test_..."

# Alternative: Stripe backend for dynamic checkout sessions
# SUBSCRIPTION_BACKEND_URL = "https://your-api.example.com/create-checkout-session"

# ========================================
# KEY MANAGEMENT
# ========================================
# Random secret for hashing subscription keys (change this to something unique)
SUBSCRIPTION_KEY_HASH_SECRET = "your-super-secret-random-string-change-me"

# Initial subscription keys (comma-separated or TOML list)
# VALID_SUBSCRIPTION_KEYS = "PRO-USER-001,PRO-USER-002,PRO-USER-003"

# Or as TOML list:
# valid_subscription_keys = ["PRO-USER-001", "PRO-USER-002", "PRO-USER-003"]

# ========================================
# ADMIN ACCESS
# ========================================
# Secret key to unlock admin dashboard
ADMIN_KEY = "your-admin-secret-key-change-me"

# Admin email for registration notifications
ADMIN_NOTIFICATION_EMAIL = "avogrowk@gmail.com"

# ========================================
# ONE-TIME PURCHASE / ENROLLMENT
# ========================================
ONE_TIME_PRICE = "30"
ONE_TIME_CURRENCY = "$"
ONE_TIME_LOCAL_PRICE = "R550"
BANK_NAME = "Capitec Bank"
BANK_ACCOUNT_HOLDER = "MR E AUGUSTYN"
BANK_ACCOUNT_NUMBER = "2520993738"
BANK_BRANCH_CODE = "470010"
WHATSAPP_PROOF_URL = "https://wa.me/27762123384?text=Hi%20Ettiene!%20I%20just%20paid%20for%20the%20Pr1ceForm%20Smart%20Money%20Indicator.%20Please%20find%20my%20proof%20of%20payment%20attached."

# ========================================
# EMAIL NOTIFICATIONS (Optional)
# ========================================
# Set these to enable email notifications for new registration requests

# Gmail setup:
# 1. Enable 2FA on your Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password below

SMTP_HOST = "smtp.gmail.com"  # e.g. smtp.gmail.com
SMTP_PORT = 587
# Use an app password for Gmail when 2FA is enabled
SMTP_USER = "your-gmail@gmail.com"
SMTP_PASS = "<YOUR_SMTP_APP_PASSWORD>"  # DO NOT commit real passwords to git

# Alternative SMTP providers:
# SendGrid: smtp.sendgrid.net:587
# AWS SES: email-smtp.<region>.amazonaws.com:587
# Mailgun: smtp.mailgun.org:587

# ========================================
# DATABASE (Auto-created, no config needed)
# ========================================
# SQLite database stores:
# - Subscription key metadata (user, email, plan, expires)
# - Audit logs of admin actions
# - Registration requests (if persisted)

# ========================================
# NOTES
# ========================================
# - Never commit secrets.toml to GitHub
# - Always use Streamlit Cloud's "Manage secrets" interface
# - Test locally with .streamlit/secrets.toml before deploying
# - Keep subscription keys in sync between Stripe and app
